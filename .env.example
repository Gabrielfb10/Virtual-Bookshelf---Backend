# ==========================================
# VIRTUAL BOOKSHELF - VARIAVEIS DE AMBIENTE
# ==========================================

# 1. Configuracoes do Banco de Dados
# Para desenvolvimento local, as configuracoes do H2 abaixo ja funcionam direto da caixa.
# Para producao, altere para a URL, classe e credenciais do seu PostgreSQL.
DB_URL=jdbc:h2:mem:testdb
DB_CLASSNAME=org.h2.Driver
DB_USER=book
DB_PASSWORD=123

# 2. Configuracoes de Seguranca (JWT)
# O JWT_SECRET eh obrigatorio e DEVE TER pelo menos 32 caracteres (Ex: HmacSHA256).
# O JWT_EXPIRATION eh o tempo de vida do token em milissegundos.
#   Ex: 86400000 = 24 horas
JWT_SECRET=coloque-sua-chave-secreta-aqui-com-mais-de-32-caracteres
JWT_EXPIRATION=86400000
